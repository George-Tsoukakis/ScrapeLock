#. translators: %d: number of files
#: includes/class-pncp-integrity.php:648
#, php-format
msgid "%d file was added or changed while the site was locked, or differs from WordPress.org."
msgid_plural "%d files were added or changed while the site was locked, or differ from WordPress.org."
msgstr[0] "%d αρχείο προστέθηκε ή άλλαξε όσο το site ήταν κλειδωμένο, ή διαφέρει από το WordPress.org."
msgstr[1] "%d αρχεία προστέθηκαν ή άλλαξαν όσο το site ήταν κλειδωμένο, ή διαφέρουν από το WordPress.org."

#: includes/class-pncp-integrity.php:649
msgid "See the files"
msgstr "Δείτε τα αρχεία"

#: includes/class-pncp-integrity.php:664
msgid "File integrity"
msgstr "Ακεραιότητα αρχείων"

#: includes/class-pncp-integrity.php:665
msgid "While the site is locked nobody can install or update anything, so a new or changed code file means that something wrote it by itself, usually through a vulnerable plugin. ScrapeLock keeps a fingerprint of every PHP, .htaccess and .user.ini file when you lock the site (and again after a temporary unlock), checks it every hour and emails the administration address about anything new. WordPress and the plugins from WordPress.org are also compared with their official copies, which finds a change made before you locked. Caches and the updater's folders are left out."
msgstr "Όσο το site είναι κλειδωμένο κανείς δεν μπορεί να εγκαταστήσει ή να ενημερώσει κάτι, οπότε ένα νέο ή αλλαγμένο αρχείο κώδικα σημαίνει ότι κάτι το έγραψε μόνο του, συνήθως μέσα από ευάλωτο plugin. Το ScrapeLock κρατά αποτύπωμα κάθε αρχείου PHP, .htaccess και .user.ini όταν κλειδώνετε το site (και ξανά μετά από προσωρινό ξεκλείδωμα), το ελέγχει κάθε ώρα και στέλνει email στη διεύθυνση διαχείρισης για ό,τι νέο βρει. Το WordPress και τα plugins από το WordPress.org συγκρίνονται επίσης με τα επίσημα αντίγραφά τους, ώστε να βρεθεί και αλλαγή που έγινε πριν το κλειδώσετε. Οι caches και οι φάκελοι του updater δεν ελέγχονται."

#. translators: 1: date, 2: number of files
#: includes/class-pncp-integrity.php:670
#, php-format
msgid "Fingerprint: %1$s, %2$d files."
msgstr "Αποτύπωμα: %1$s, %2$d αρχεία."

#: includes/class-pncp-integrity.php:672
msgid "No fingerprint yet: it is taken when you lock the site."
msgstr "Δεν υπάρχει ακόμη αποτύπωμα: παίρνεται όταν κλειδώνετε το site."

#. translators: %s: date
#: includes/class-pncp-integrity.php:676
#, php-format
msgid "Last check: %s."
