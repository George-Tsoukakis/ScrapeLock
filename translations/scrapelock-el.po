msgstr "Ξανά κλείδωμα"

#: includes/class-pncp-lockdown.php:1469
msgid "Wrong code"
msgstr "Λάθος κωδικός"

#: includes/class-pncp-lockdown.php:1470
msgid "Recovery code used"
msgstr "Χρήση κωδικού ανάκτησης"

#: includes/class-pncp-lockdown.php:1471
msgid "New recovery codes"
msgstr "Νέοι κωδικοί ανάκτησης"

#: includes/class-pncp-lockdown.php:1472
msgid "App removed"
msgstr "Αφαίρεση εφαρμογής"

#: includes/class-pncp-lockdown.php:1473
msgid "Change refused"
msgstr "Αλλαγή που απορρίφθηκε"

#: includes/class-pncp-lockdown.php:1474
msgid "Frozen roles changed"
msgstr "Αλλαγή ρόλων που παγώνουν"

#: includes/class-pncp-lockdown.php:1477
msgid "Quarantine setting"
msgstr "Ρύθμιση καραντίνας"

#: includes/class-pncp-lockdown.php:1480
msgid "Recent lockdown events"
msgstr "Πρόσφατα συμβάντα κλειδώματος"

#: includes/class-pncp-lockdown.php:1482
msgid "When"
msgstr "Πότε"

#: includes/class-pncp-lockdown.php:1482
