msgstr[1] "%s διαφορετικά User-Agents σε αυτό το λεπτό"

#. translators: %s: days
#: includes/class-pncp-admin.php:1756
#, php-format
msgid "The log is deleted automatically after %s days (setting in the “Bots and limits” tab)."
msgstr "Το αρχείο σβήνεται αυτόματα μετά από %s ημέρες (ρύθμιση στην καρτέλα «Bots και όρια»)."

#: includes/class-pncp-admin.php:1764
msgid "Delete log"
msgstr "Διαγραφή αρχείου"

#: includes/class-pncp-admin.php:1776
#: includes/class-pncp-admin.php:1803
#: includes/class-pncp-admin.php:1908
#: includes/class-pncp-admin.php:1930
msgid "Nothing."
msgstr "Τίποτα."

#: includes/class-pncp-admin.php:1782
msgid "IPs"
msgstr "IP"

#: includes/class-pncp-admin.php:1821
msgid "Blocked permanently"
msgstr "Μόνιμα αποκλεισμένη"

#. translators: %s: company, e.g. Anthropic or Cloudflare
#: includes/class-pncp-admin.php:1832
#, php-format
msgid "Official %s address"
msgstr "Επίσημη διεύθυνση %s"

#: includes/class-pncp-admin.php:1833
msgid "No “Block permanently” here: the address is in an official list, so blocking it would also stop that company's search bots, or every visitor behind a CDN. Its training crawlers are already blocked by the bot list (User-Agent)."
msgstr "Χωρίς «Μόνιμο αποκλεισμό» εδώ: η διεύθυνση είναι σε επίσημη λίστα, οπότε ο αποκλεισμός της θα σταματούσε και τα bots αναζήτησης της εταιρείας ή, για CDN, όλους τους επισκέπτες πίσω από αυτό. Τα crawlers εκπαίδευσής της τα μπλοκάρει ήδη η λίστα bots (User-Agent)."

#: includes/class-pncp-admin.php:1841
msgid "Block permanently"
msgstr "Μόνιμος αποκλεισμός"

#: includes/class-pncp-admin.php:1856
msgid "Persistent IPs (last 7 days)"
msgstr "Επίμονες IP (τελευταίες 7 ημέρες)"

#. translators: %s: number of requests
#: includes/class-pncp-admin.php:1862
#, php-format
msgid "IPs with at least two temporary blocks, or at least %s blocked requests. They keep coming back: you can block them permanently."
msgstr "IP με τουλάχιστον δύο προσωρινούς αποκλεισμούς ή τουλάχιστον %s μπλοκαρισμένα αιτήματα. Επιστρέφουν συνέχεια: μπορείτε να τις αποκλείσετε μόνιμα."

#: includes/class-pncp-admin.php:1878
msgid "Temporary blocks"
msgstr "Προσωρινοί αποκλεισμοί"

#: includes/class-pncp-admin.php:1879
msgid "Blocked requests"
msgstr "Μπλοκαρισμένα αιτήματα"

#: includes/class-pncp-admin.php:1880
msgid "Main reason"
msgstr "Κύριος λόγος"

#: includes/class-pncp-admin.php:1881
msgid "Last seen"
msgstr "Τελευταία φορά"

#: includes/class-pncp-admin.php:1939
msgid "Fake: not from the official addresses"
msgstr "Ψεύτικο: όχι από τις επίσημες διευθύνσεις"

#: includes/class-pncp-admin.php:1941
msgid "Known bot name, not verified"
msgstr "Γνωστό όνομα bot, χωρίς επαλήθευση"

#: includes/class-pncp-admin.php:1964
#: includes/class-pncp-status.php:120
#: includes/class-pncp-status.php:159
msgid "You are not allowed to change this setting."
msgstr "Δεν έχετε δικαίωμα να αλλάξετε αυτή τη ρύθμιση."

#: includes/class-pncp-admin.php:2168
msgid "Preset applied."
msgstr "Το προφίλ εφαρμόστηκε."

#: includes/class-pncp-admin.php:2169
msgid "New token created."
msgstr "Δημιουργήθηκε νέο token."

#: includes/class-pncp-admin.php:2170
msgid "Previous token revoked."
msgstr "Το προηγούμενο token ακυρώθηκε."

#: includes/class-pncp-admin.php:2171
msgid "Block lifted."
msgstr "Ο αποκλεισμός άρθηκε."

#: includes/class-pncp-admin.php:2172
msgid "Log deleted."
msgstr "Το αρχείο διαγράφηκε."

#: includes/class-pncp-admin.php:2173
msgid "The IP was added to the always-blocked IPs (“Bots and limits” → “Always blocked”). You can remove it there."
msgstr "Η IP προστέθηκε στις πάντα αποκλεισμένες IP («Bots και όρια» → «Πάντα αποκλεισμένα»). Μπορείτε να την αφαιρέσετε από εκεί."

#: includes/class-pncp-admin.php:2174
msgid "The IP is already in the always-blocked IPs."
msgstr "Η IP είναι ήδη στις πάντα αποκλεισμένες IP."

#: includes/class-pncp-admin.php:2175
msgid "The always-blocked IPs already have 200 lines. Combine addresses into CIDR ranges there first."
msgstr "Οι πάντα αποκλεισμένες IP έχουν ήδη 200 γραμμές. Ενώστε πρώτα διευθύνσεις σε περιοχές CIDR εκεί."

#: includes/class-pncp-admin.php:2176
msgid "This IP cannot be blocked permanently: it is the server itself, your own IP, a private address, an always-allowed IP or an address in an official list (Google, Bing, AI search services, Cloudflare, Bunny CDN)."
msgstr "Αυτή η IP δεν μπορεί να μπλοκαριστεί μόνιμα: είναι ο ίδιος ο server, η δική σας IP, ιδιωτική διεύθυνση, πάντα επιτρεπτή IP ή διεύθυνση από επίσημη λίστα (Google, Bing, υπηρεσίες AI αναζήτησης, Cloudflare, Bunny CDN)."

#: includes/class-pncp-admin.php:2177
msgid "IP lists refreshed."
msgstr "Οι λίστες IP ανανεώθηκαν."

#: includes/class-pncp-admin.php:2178
msgid "Country database downloaded."
msgstr "Η βάση χωρών κατέβηκε."

#: includes/class-pncp-admin.php:2179
msgid "The country database could not be downloaded or read; the previous one (if any) was kept. It will try again tomorrow."
msgstr "Η βάση χωρών δεν κατέβηκε ή δεν διαβάστηκε· κρατήθηκε η προηγούμενη (αν υπάρχει). Θα ξαναδοκιμάσει αύριο."

#: includes/class-pncp-admin.php:2180
msgid "The real visitor IP is now read from CF-Connecting-IP, only for requests from Cloudflare."
msgstr "Η πραγματική IP του επισκέπτη διαβάζεται τώρα από το CF-Connecting-IP, μόνο για αιτήματα από την Cloudflare."

#: includes/class-pncp-admin.php:2181
msgid "The real visitor IP is now read from X-Real-IP, only for requests from Bunny CDN."
msgstr "Η πραγματική IP του επισκέπτη διαβάζεται πλέον από το X-Real-IP, μόνο για αιτήματα από το Bunny CDN."

#: includes/class-pncp-admin.php:2182
msgid "X-Real-IP is selected for Bunny CDN, but the list of Bunny addresses could not be downloaded. Until it is, the header is not trusted. It will try again tomorrow, or use “Refresh now” under “Official IP lists”."
msgstr "Επιλέχθηκε X-Real-IP για το Bunny CDN, αλλά η λίστα με τις διευθύνσεις του Bunny δεν μπόρεσε να κατέβει. Μέχρι να κατέβει, η κεφαλίδα δεν γίνεται δεκτή. Θα ξαναδοκιμάσει αύριο, ή πατήστε «Ανανέωση τώρα» στις «Επίσημες λίστες IP»."

#: includes/class-pncp-admin.php:2183
msgid "Some IP lists could not be downloaded; their previous version was kept. It will try again tomorrow."
msgstr "Κάποιες λίστες IP δεν κατέβηκαν· κρατήθηκε η προηγούμενη εκδοχή τους. Θα ξαναδοκιμάσει αύριο."

#: includes/class-pncp-admin.php:2184
msgid "Connected to the CDN. From now on the IPs ScrapeLock blocks temporarily are also blocked there (within a minute or two)."
msgstr "Συνδέθηκε με το CDN. Από τώρα οι IP που το ScrapeLock αποκλείει προσωρινά αποκλείονται και εκεί (μέσα σε ένα-δύο λεπτά)."

#: includes/class-pncp-admin.php:2185
msgid "Blocking at the CDN is off. The blocks ScrapeLock made there are being removed in the background."
msgstr "Ο αποκλεισμός στο CDN είναι ανενεργός. Οι αποκλεισμοί που έκανε εκεί το ScrapeLock σβήνονται στο παρασκήνιο."

#: includes/class-pncp-admin.php:2186
msgid "The zone ID is not valid: Cloudflare uses 32 letters and digits (0–9, a–f), Bunny CDN a number. Nothing was saved."
msgstr "Το zone ID δεν είναι έγκυρο: η Cloudflare χρησιμοποιεί 32 γράμματα και ψηφία (0–9, a–f), το Bunny CDN έναν αριθμό. Δεν αποθηκεύτηκε τίποτα."

#: includes/class-pncp-admin.php:2187
msgid "Enter the API token (letters, digits, “-” and “_”). Nothing was saved."
msgstr "Συμπληρώστε το API token (γράμματα, ψηφία, «-» και «_»). Δεν αποθηκεύτηκε τίποτα."

#: includes/class-pncp-admin.php:2188
msgid "The connection test failed, so nothing was saved."
msgstr "Ο έλεγχος σύνδεσης απέτυχε, οπότε δεν αποθηκεύτηκε τίποτα."

#: includes/class-pncp-admin.php:2191
msgid "The action was not completed."
msgstr "Η ενέργεια δεν ολοκληρώθηκε."

#: includes/class-pncp-admin.php:2210
msgid "Since 2.1 the feed token is stored only as a hash. The old token is still valid but can no longer be shown. If you have not saved it, create a new token."
msgstr "Από την 2.1 το token των feeds αποθηκεύεται μόνο ως hash. Το παλιό token εξακολουθεί να ισχύει, αλλά δεν μπορεί πλέον να εμφανιστεί. Αν δεν το έχετε αποθηκευμένο, δημιουργήστε νέο token."

#: includes/class-pncp-admin.php:2212
msgid "Feeds and token"
msgstr "Feeds και token"

#: includes/class-pncp-admin.php:2218
msgid "ScrapeLock: the real IP is read from a header without checking the proxy (as in 1.4). This allows IP spoofing."
msgstr "Προστασία περιεχομένου: η πραγματική IP διαβάζεται από header χωρίς έλεγχο του proxy (όπως στην 1.4). Αυτό επιτρέπει πλαστογράφηση της IP."

#: includes/class-pncp-admin.php:2220
msgid "Trusted Proxy settings"
msgstr "Ρύθμιση Trusted Proxy"

#: includes/class-pncp-bots.php:218
msgid "Sorry, you are not allowed to list users."
msgstr "Δεν επιτρέπεται η προβολή της λίστας χρηστών."

#: includes/class-pncp-bots.php:241
#: includes/class-pncp-bots.php:1075
#: includes/class-pncp-graphql.php:61
msgid "Too many requests. Please try again in a minute."
msgstr "Πάρα πολλά αιτήματα. Δοκιμάστε ξανά σε ένα λεπτό."

#: includes/class-pncp-bots.php:241
#: includes/class-pncp-bots.php:1077
#: includes/class-pncp-graphql.php:61
msgid "Access denied."
msgstr "Η πρόσβαση δεν επιτρέπεται."

#: includes/class-pncp-bots.php:1126
msgid "Archive"
msgstr "Αρχείο"

#: includes/class-pncp-cli.php:56
msgid "Blocked requests, last 24 hours"
msgstr "Αποκλεισμένα αιτήματα, τελευταίες 24 ώρες"

#: includes/class-pncp-edge.php:640
msgid "The CDN did not return the new block."
msgstr "Το CDN δεν επέστρεψε τον νέο αποκλεισμό."

#: includes/class-pncp-edge.php:724
#: includes/class-pncp-edge.php:751
msgid "Fill in the zone ID and the token."
msgstr "Συμπληρώστε το zone ID και το token."

