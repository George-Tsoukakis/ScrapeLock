msgstr[0] "Το πολύ %d αίτημα REST API / GraphQL ανά λεπτό ανά IP"
msgstr[1] "Το πολύ %d αιτήματα REST API / GraphQL ανά λεπτό ανά IP"

#. translators: %d: number of pages
#: includes/class-pncp-options.php:1592
#, php-format
msgid "At most %d “page not found” per minute per IP"
msgid_plural "At most %d “page not found” per minute per IP"
