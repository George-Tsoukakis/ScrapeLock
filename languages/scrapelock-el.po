msgid "Not through the CDN (straight to the server)"
msgstr "Όχι μέσω του CDN (απευθείας στον διακομιστή)"

#: includes/class-pncp-log.php:341
msgid "Attack in the User-Agent (tags, Shellshock, Log4Shell, SQL)"
msgstr "Επίθεση στο User-Agent (tags, Shellshock, Log4Shell, SQL)"

#: includes/class-pncp-log.php:342
