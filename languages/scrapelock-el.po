#: includes/class-pncp-bunny.php:4720
#, php-format
msgid "No rule “%s” made by ScrapeLock. See: wp scrapelock bunny rules"
msgstr ""
"Δεν υπάρχει κανόνας «%s» του ScrapeLock. Δείτε: wp scrapelock bunny rules"

#: includes/class-pncp-bunny.php:4738
msgid "Give the path of a Bunny log file."
msgstr "Δώστε τη διαδρομή ενός αρχείου log του Bunny."

#: includes/class-pncp-bunny.php:4762
msgid ""
"Use: status, import, rules, presets, lock <preset>, unlock <preset|rule>, "
"logging [--enable] or parse <file>."
msgstr ""
"Χρήση: status, import, rules, presets, lock <preset>, unlock <preset|rule>, "
"logging [--enable] ή parse <file>."

#: includes/class-pncp-cli.php:108
