msgstr ""
"Ο ιστότοπος δεν μπόρεσε να φτάσει στη δημόσια διεύθυνσή του (%s)· απευθείας "
"στον διακομιστή λειτουργεί, και οι έλεγχοι του ScrapeLock χρησιμοποιούν "
"αυτόν τον δρόμο."

#. translators: %s: error message
#: includes/class-pncp-self-check.php:1002
#, php-format
msgid ""
"The site could not reach its public address (%s), nor the server directly."
msgstr ""
"Ο ιστότοπος δεν μπόρεσε να φτάσει στη δημόσια διεύθυνσή του (%s) ούτε "
"απευθείας στον διακομιστή."

#. translators: 1: who refused (e.g. "Bunny CDN edge"), 2: HTTP status code
#: includes/class-pncp-self-check.php:1012
#, php-format
msgid ""
"The site's own request through its public address was refused by %1$s (HTTP "
