msgid_plural "At most %d pages per minute per IP"
msgstr[0] "Το πολύ %d σελίδα ανά λεπτό ανά IP"
msgstr[1] "Το πολύ %d σελίδες ανά λεπτό ανά IP"

#. translators: %d: number of searches
#: includes/class-pncp-options.php:1586
#, php-format
msgid "At most %d search per minute per IP"
msgid_plural "At most %d searches per minute per IP"
msgstr[0] "Το πολύ %d αναζήτηση ανά λεπτό ανά IP"
msgstr[1] "Το πολύ %d αναζητήσεις ανά λεπτό ανά IP"

#. translators: %d: number of requests
#: includes/class-pncp-options.php:1589
#, php-format
msgid "At most %d REST API / GraphQL request per minute per IP"
