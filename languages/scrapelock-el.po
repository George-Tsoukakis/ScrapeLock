msgstr "Αφαιρέθηκε ενώ ήταν κλειδωμένο"

#: includes/class-pncp-integrity.php:1370
msgid "Differs from WordPress.org"
msgstr "Διαφέρει από το WordPress.org"

#: includes/class-pncp-integrity.php:1371
msgid "Not part of the WordPress.org copy"
msgstr "Δεν ανήκει στο αντίγραφο του WordPress.org"

#: includes/class-pncp-integrity.php:1373
msgid "New while unlocked"
msgstr "Νέο ενώ ήταν ξεκλείδωτο"

#: includes/class-pncp-integrity.php:1374
msgid "Changed while unlocked"
msgstr "Άλλαξε ενώ ήταν ξεκλείδωτο"

#: includes/class-pncp-integrity.php:1375
msgid "Removed while unlocked"
msgstr "Αφαιρέθηκε ενώ ήταν ξεκλείδωτο"

#: includes/class-pncp-integrity.php:1727
msgid "The saved fingerprint of this code was changed in the database."
msgstr "Το αποθηκευμένο αποτύπωμα αυτού του κώδικα άλλαξε στη βάση δεδομένων."

#. translators: %s: plugin file
#: includes/class-pncp-integrity.php:1776
#: includes/class-pncp-integrity.php:1827
#, php-format
