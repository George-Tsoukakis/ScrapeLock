#. Plugin Name of the plugin
#: scrapelock.php:3
msgid "ScrapeLock – Content & AI Bot Protection"
msgstr ""

#. Description of the plugin
#: scrapelock.php:4
msgid "Protects your content: makes copying text and images harder, hides the text in the REST API, GraphQL and RSS, blocks scrapers, AI bots and fake Googlebots, temporarily blocks persistent IPs, protects XML feeds with a token and adds an optional watermark. Lockdown freezes every change to the site until it is unlocked with an authenticator app. Forms, cart, checkout and search engines are not affected."
msgstr ""

#. Author of the plugin
#: scrapelock.php:8
msgid "CodeBunny"
msgstr ""

