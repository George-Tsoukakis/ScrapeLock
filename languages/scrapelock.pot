#. Plugin Name of the plugin
#: scrapelock.php:3
msgid "ScrapeLock – Content & AI Bot Protection"
msgstr ""

#. Description of the plugin
#: scrapelock.php:4
msgid "Protects your content: makes copying text and images harder, hides the text in the REST API, GraphQL and RSS, blocks scrapers, AI bots and fake Googlebots, temporarily blocks persistent IPs, protects XML feeds with a token and adds an optional watermark. Forms, cart, checkout and search engines are not affected."
msgstr ""

